{
  "name": "pc-remote-commander",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "SUPABASE_URL": "https://aaaaaaaaaaaaaaaaaaaa.supabase.co",
    "PCRC_EMAIL_AUTH_ENABLED": "0",
    "JAN_PUBLIC_ORIGIN": "https://pc-remote-commander.example.workers.dev",
    "JAN_ORIGIN": "https://unused-development.trycloudflare.com",
    "GITHUB_CLIENT_ID": "",
    "ALLOWED_GITHUB_ID": "1234",
    "JAN_AUTO_ORIGIN": "1",
    "JAN_RELAY_ENABLED": "1",
    "JAN_PAIRING_ENABLED": "1",
    "JAN_MULTI_USER_ENABLED": "1",
    "JAN_SITE_ROLE": "public",
    "PADDLE_PRICE_ID": "",
    "PADDLE_ENVIRONMENT": "production",
    "PADDLE_LIVE_ENABLED": "0"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000003"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PACKAGE_BUCKET",
      "bucket_name": "pcrc-example-packages-3"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICES",
        "class_name": "JanDeviceStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "production-device-store-v1",
      "new_sqlite_classes": [
        "JanDeviceStore"
      ]
    }
  ],
  "services": [
    {
      "binding": "BILLING_SERVICE",
      "service": "pc-remote-commander-ops"
    }
  ]
}
